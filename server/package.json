{
  "name": "@todo/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../.env scripts/check-port.ts && tsx watch --clear-screen=false --env-file-if-exists=../.env src/index.ts",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=../.env src/db/migrate-cli.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
