# Copy to .env (git-ignored). PORT and DATABASE_PATH are optional (defaults shown).
PORT=3001
DATABASE_PATH=data/todo.db
# Required, at least 32 characters. This placeholder is deliberately too short: replace it.
# Generate one: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me
# Token lifetime: seconds or <n>s|m|h|d (max 30d). Default 24h.
JWT_EXPIRES_IN=24h
